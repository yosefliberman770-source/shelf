# Copy to .env or export in your shell. Keys stay on the server.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# COMPATIBLE_BASE_URL=http://localhost:11434/v1   # e.g. Ollama / LM Studio
# COMPATIBLE_API_KEY=
# SHELF_ALLOW_KEY_CONFIG=true                     # allow saving keys from Settings → AI
# PORT=8787

# Historical maps — World Historical Gazetteer (https://whgazetteer.org/). Server-side only.
# WHG_API_TOKEN=
# WHG_USER_AGENT=Shelf-reading-app/1.0 (you@example.com)   # optional; identifies your app to WHG
# SHELF_ALLOWED_ORIGINS=https://<you>.github.io            # let the hosted app call this server

# Free AI providers (optional). Most can be entered on the phone in Settings → AI instead,
# where the key stays on that device. Cloudflare and NVIDIA block browser calls, so they
# only work through this server. Never commit a real key — .env is git-ignored.
# GROQ_API_KEY=
# MISTRAL_API_KEY=
# OPENROUTER_API_KEY=
# CEREBRAS_API_KEY=
# CLOUDFLARE_API_KEY=
# CLOUDFLARE_ACCOUNT_ID=
# NVIDIA_API_KEY=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
# HUGGINGFACE_API_KEY=
# COHERE_API_KEY=
