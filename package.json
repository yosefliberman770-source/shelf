{
  "name": "shelf",
  "private": true,
  "version": "1.0.0",
  "description": "Shelf — a personal reading operating system",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite",
    "dev:server": "node --watch server/index.ts",
    "build": "tsc -b && vite build",
    "start": "node server/index.ts",
    "test": "vitest run",
    "typecheck": "tsc -b"
  },
  "engines": {
    "node": ">=22.18"
  },
  "dependencies": {
    "d3-force": "^3.0.0",
    "dexie": "^4.4.6",
    "dexie-react-hooks": "^4.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@types/d3-force": "^3.0.10",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "fake-indexeddb": "^6.2.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
