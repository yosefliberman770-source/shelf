 "title": "Cultural heritage register of Norway (Riksantikvaren, Askeladden/Kulturminnesøk; OGC API), dated sites",
 "licence": "NLOD 1.0 (Norwegian licence for open government data)",
 "url": "https://api.ra.no/kulturminner/collections/kulturminner",
 "describe": "Graves, settlements, church sites, defences, trapping pits, charcoal pits, buildings and other registered cultural heritage sites (lokaliteter) of Norway. A site is shown over its own exact dating where that is a plain year or range, else over its register class, with the years of the official code list (KulturminneDatering, Ordnøkkelen): quarter-centuries and centuries as listed there (e.g. '1800s, fourth quarter' = 1875–1899), Iron Age 500 BC–1050, Roman Iron Age 0–400, Early Iron Age 500 BC–570 (to the end of the code list's Migration Period). Migration Period to Middle Ages classes are already on the map from the register's individual monuments (nokm) and are not repeated. Bronze Age–Iron Age, Iron Age–Middle Ages and Viking Age–Middle Ages classes (each over 700 years), 'post-Reformation', 'pre-Reformation', 'older than 100 years', the Svalbard before/after 1945 classes and undated records are left out.",
 "layers": [
  "medieval-archaeology"
 ],
 "read": {
  "path": "norway-kulturminner/original/kulturminner_dated.geojson"
 },
 "fields": {
  "id": "lokalitetid",
  "name": "navn",
  "type": [
   "lokalitetsart",
   "enkeltminneart"
  ],
  "context": [
   "kommune",
   "fylke"
  ],
  "kind": {
   "field": "lokalitetsart",
   "map": {
    "bosetning-aktivitetsområde": "settlement",
    "kirkested": "church",
    "kirke": "church",
    "klosteranlegg": "monastery",
    "borg": "castle",
    "forsvarsanlegg": "castle",
    "befestning": "castle",
    "bygning": "building",
    "bygningsmiljø": "building",
    "bru": "bridge",
