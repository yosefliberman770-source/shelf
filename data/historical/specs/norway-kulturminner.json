    "ferdselsminne": "road",
    "havn": "harbour",
    "skipsfunn": "wreck",
    "kullfremstillingsanlegg": "mill",
    "jernvinneanlegg": "mine",
    "bergverk": "mine",
    "gruve": "mine",
    "tingsted": "site"
   },
   "default": "site"
  }
 },
